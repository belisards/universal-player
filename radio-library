#!/usr/bin/env python3
"""Index the user's music folders as rows understood by the Atlas player."""

import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor


CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "radio-atlas"
CACHE_FILE = CACHE_DIR / "library.json"
COVER_DIR = CACHE_DIR / "covers"
CACHE_CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "radio-atlas" / "connectors.json"
CACHE_TTL = 3600
AUDIO_SUFFIXES = {".mp3", ".flac", ".ogg", ".oga", ".m4a", ".opus", ".wav"}
COVER_NAMES = ("cover", "folder", "front", "album", "artwork", "capa")


def music_roots():
    configured = os.environ.get("RADIO_ATLAS_MUSIC_DIRS", "")
    candidates = configured.split(":") if configured else []
    has_explicit_config = bool(configured)
    if not candidates and CACHE_CONFIG.is_file():
        has_explicit_config = True
        try:
            with CACHE_CONFIG.open() as handle:
                document = json.load(handle)
            candidates = [
                str(row.get("path", "")) for row in document.get("connectors", [])
                if row.get("type") == "folder" and row.get("enabled", True)
            ]
        except (OSError, ValueError, AttributeError):
            candidates = []
    if not candidates and not has_explicit_config:
        candidates = [str(Path.home() / "Music")]
    roots = []
    for candidate in candidates:
        path = Path(candidate).expanduser().resolve()
        if path.is_dir() and path not in roots:
            roots.append(path)
    return roots


def clean(value):
    if isinstance(value, list):
        value = value[0] if value else ""
    return re.sub(r"[\r\n\t]+", " ", str(value or "")).strip()


def probe(path):
    try:
        process = subprocess.run(
            [
                "ffprobe", "-v", "error", "-show_entries",
                "format=duration:format_tags=artist,album_artist,album,title,date,track",
                "-of", "json", "--", str(path),
            ],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=8,
        )
        document = json.loads(process.stdout)
        fmt = document.get("format") or {}
        return fmt.get("tags") or {}, float(fmt.get("duration") or 0)
    except (OSError, ValueError, subprocess.SubprocessError):
        return {}, 0


def cover_for(directory):
    try:
        images = [p for p in directory.iterdir() if p.is_file() and p.suffix.lower() in {".jpg", ".jpeg", ".png", ".webp"}]
        mediaart = directory / ".mediaartlocal"
        if mediaart.is_dir():
            images.extend(p for p in mediaart.iterdir()
                          if p.is_file() and p.suffix.lower() in {".jpg", ".jpeg", ".png", ".webp"})
    except OSError:
        return ""
    for wanted in COVER_NAMES:
        for image in images:
            if image.stem.lower() == wanted:
                return image.resolve().as_uri()
    return images[0].resolve().as_uri() if len(images) == 1 else ""


def album_key_for(root, directory, tags):
    album = clean(tags.get("album")) or directory.name or "Loose tracks"
    artist = clean(tags.get("album_artist")) or clean(tags.get("artist"))
    identity = f"{root}\0{artist}\0{album}\0{directory}"
    return hashlib.sha1(identity.encode()).hexdigest()[:20]


def embedded_cover(path, album_key):
    COVER_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    destination = COVER_DIR / f"{album_key}.jpg"
    if destination.is_file() and destination.stat().st_size > 0:
        return destination.resolve().as_uri()
    temporary = COVER_DIR / f"{album_key}.tmp.jpg"
    try:
        subprocess.run(
            [
                "ffmpeg", "-nostdin", "-v", "error", "-y", "-i", str(path),
                "-map", "0:v:0", "-frames:v", "1",
                "-vf", "scale=600:600:force_original_aspect_ratio=decrease",
                "-q:v", "3", str(temporary),
            ],
            check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=15,
        )
        if temporary.is_file() and temporary.stat().st_size > 0:
            os.replace(temporary, destination)
            return destination.resolve().as_uri()
    except (OSError, subprocess.SubprocessError):
        pass
    try:
        temporary.unlink()
    except OSError:
        pass
    return ""


def fallback_track(path):
    title = re.sub(r"^\s*\d{1,3}\s*[.\-_)]*\s*", "", path.stem).strip()
    return title or path.stem


def row_for(path, root, album_tags, album_duration=0, album_cover=""):
    # One probe per album keeps cloud-backed folders responsive. Filenames are
    # intentionally the fallback for individual track titles; a later refresh
    # can enrich these without changing the connector contract.
    tags = album_tags
    is_probe_file = path.name == album_tags.get("__probe_file")
    duration = album_duration if is_probe_file else 0
    relative = path.relative_to(root)
    parents = relative.parts[:-1]
    album_fallback = parents[-1] if parents else "Loose tracks"
    artist_fallback = parents[-2] if len(parents) >= 2 and parents[-2].lower() != "hd" else ""
    title = (clean(tags.get("title")) if is_probe_file else "") or fallback_track(path)
    artist = clean(tags.get("artist")) or clean(tags.get("album_artist")) or artist_fallback
    album_artist = clean(tags.get("album_artist")) or artist or artist_fallback
    album = clean(tags.get("album")) or album_fallback
    year_match = re.search(r"(?:19|20)\d{2}", clean(tags.get("date")) or album)
    year = year_match.group(0) if year_match else ""
    track_value = clean(tags.get("track")) if is_probe_file else path.stem
    track_match = re.match(r"\s*\d+", track_value)
    track_number = int(track_match.group(0)) if track_match else 0
    cover = album_cover
    album_key = album_key_for(root, path.parent, tags)
    uuid = hashlib.sha256(f"local\0{path}".encode()).hexdigest()
    album_line = " · ".join(value for value in (album, year) if value)
    return {
        "uuid": uuid,
        "kind": "track",
        "provider": "local",
        "source": "library",
        "name": f"{title} — {artist}" if artist else title,
        "title": title,
        "artist": artist,
        "albumArtist": album_artist,
        "album": album,
        "albumKey": album_key,
        "year": year,
        "trackNumber": track_number,
        "duration": round(duration, 3),
        "url": path.resolve().as_uri(),
        "homepage": path.parent.resolve().as_uri(),
        "favicon": cover,
        "cover": cover,
        "country": "",
        "countryCode": "",
        "state": "My Music",
        "language": "",
        "tags": ",".join(value for value in ("local", album_artist, album_line) if value)[:500],
        "codec": path.suffix.lstrip(".").upper(),
        "bitrate": 0,
        "votes": 0,
        "clicks": 0,
        "latitude": None,
        "longitude": None,
    }


def scan():
    rows = []
    for root in music_roots():
        try:
            paths = sorted(
                path for path in root.rglob("*")
                if path.is_file() and path.suffix.lower() in AUDIO_SUFFIXES
            )
        except OSError:
            continue
        albums = {}
        for path in paths:
            albums.setdefault(path.parent, []).append(path)
        album_groups = list(albums.values())
        def inspect_album(group):
            tags, duration = probe(group[0])
            album_key = album_key_for(root, group[0].parent, tags)
            cover = cover_for(group[0].parent) or embedded_cover(group[0], album_key)
            return tags, duration, cover
        with ThreadPoolExecutor(max_workers=min(8, len(album_groups) or 1)) as executor:
            metadata = list(executor.map(inspect_album, album_groups))
        for album_paths, (tags, duration, cover) in zip(album_groups, metadata):
            tags["__probe_file"] = album_paths[0].name
            rows.extend(row_for(path, root, tags, duration, cover) for path in album_paths)
    rows.sort(key=lambda row: (
        row["albumArtist"].casefold(), row["album"].casefold(),
        row["trackNumber"], row["title"].casefold()
    ))
    return rows[:500]


def load(refresh=False):
    CACHE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    if not refresh and CACHE_FILE.exists() and time.time() - CACHE_FILE.stat().st_mtime < CACHE_TTL:
        try:
            with CACHE_FILE.open() as handle:
                rows = json.load(handle)
            if isinstance(rows, list) and len(rows) <= 500:
                return rows
        except (OSError, ValueError):
            pass
    rows = scan()
    temporary = CACHE_FILE.with_suffix(".tmp")
    with temporary.open("w") as handle:
        json.dump(rows, handle, ensure_ascii=False)
    os.replace(temporary, CACHE_FILE)
    return rows


def main():
    refresh = len(sys.argv) > 1 and sys.argv[1] == "refresh"
    json.dump(load(refresh), sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
