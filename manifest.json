{
  "schemaVersion": 1,
  "id": "akshar.radio-atlas",
  "name": "Universal Player",
  "version": "0.3.0",
  "author": "belisards and Akshar Patel",
  "license": "MIT",
  "description": "Play world radio, embedded IPTV, live YouTube subscriptions, Tocador archives, and your own albums.",
  "homepage": "https://github.com/belisards/universal-player",
  "repository": "https://github.com/belisards/universal-player",
  "keywords": [
    "radio",
    "world",
    "globe",
    "music",
    "albums",
    "tocador",
    "nextcloud",
    "tv",
    "iptv",
    "youtube",
    "mpris"
  ],
  "kinds": [
    "panel",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "panel": "RadioAtlas.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Universal Player",
    "description": "Open radio, IPTV, YouTube, albums, and connected music folders",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "center"
  }
}
