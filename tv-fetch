#!/usr/bin/env python3
"""Live TV channels from iptv-org and live YouTube subscriptions, shaped like Radio Browser station rows."""

import fcntl
import hashlib
import json
import os
import random
import re
import subprocess
import sys
import tempfile
import time
import urllib.request
from pathlib import Path

API = "https://iptv-org.github.io/api"
MAX_DOWNLOAD_BYTES = 16 * 1024 * 1024
MAX_CATALOG_ROWS = 20000
WORLD_ROWS = 5000
CATALOG_MAX_AGE = 24 * 60 * 60
UUID_PATTERN = re.compile(r"^[0-9A-Fa-f-]{20,64}$")
CONTROL = re.compile(r"[\x00-\x1f\x7f]")
YOUTUBE = "https://www.youtube.com"
YOUTUBE_MAX_AGE = 3 * 60
CHANNEL_ID = re.compile(r"^UC[0-9A-Za-z_-]{22}$")

script_dir = Path(__file__).resolve().parent
cache_dir = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "omarchy-radio-atlas"
catalog_file = cache_dir / "tv.json"
lock_file = cache_dir / "tv.lock"
youtube_file = cache_dir / "youtube-live.json"
connectors_file = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "radio-atlas" / "connectors.json"
version = json.loads((script_dir / "manifest.json").read_text()).get("version", "0")
user_agent = f"Radio Atlas/{version} (https://github.com/belisards/tocador-widget)"

